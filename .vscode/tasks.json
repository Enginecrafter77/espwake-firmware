{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "cmake",
            "command": "build",
            "group": "build"
        },
        {
            "label": "flash",
            "type": "shell",
            "command": "make",
            "args": [
                "flash"
            ],
            "options": {
                "cwd": "${workspaceFolder}/build",
                "env": {
                    "ESPPORT": "/dev/ttyUSB0",
                    "ESPBAUD": "115200"
                }
            },
            "dependsOn": "build",
            "group": "none",
            "problemMatcher": []
        }
    ]
}
